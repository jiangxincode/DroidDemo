<resources>

    <!--
        MD3 Typography System:
        All 15 Material Design 3 typography styles are inherited from the Theme.Material3.DayNight parent theme:
          Display:  textAppearanceDisplayLarge, textAppearanceDisplayMedium, textAppearanceDisplaySmall
          Headline: textAppearanceHeadlineLarge, textAppearanceHeadlineMedium, textAppearanceHeadlineSmall
          Title:    textAppearanceTitleLarge, textAppearanceTitleMedium, textAppearanceTitleSmall
          Body:     textAppearanceBodyLarge, textAppearanceBodyMedium, textAppearanceBodySmall
          Label:    textAppearanceLabelLarge, textAppearanceLabelMedium, textAppearanceLabelSmall
        No custom font overrides are needed. Use ?attr/textAppearanceBodyLarge etc. in layouts.
    -->

    <style name="AppTheme.NoActionBar" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- MD3 Color Roles -->
        <item name="colorPrimary">@color/md3_primary</item>
        <item name="colorOnPrimary">@color/md3_on_primary</item>
        <item name="colorPrimaryContainer">@color/md3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md3_on_primary_container</item>
        <item name="colorSecondary">@color/md3_secondary</item>
        <item name="colorOnSecondary">@color/md3_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md3_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md3_on_secondary_container</item>
        <item name="colorTertiary">@color/md3_tertiary</item>
        <item name="colorSurface">@color/md3_surface</item>
        <item name="colorOnSurface">@color/md3_on_surface</item>
        <item name="colorSurfaceVariant">@color/md3_surface_variant</item>
        <item name="colorOutline">@color/md3_outline</item>
        <!-- MD3 Shape Attributes -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.App.LargeComponent</item>
    </style>

    <style name="AppTheme.ActionBar" parent="Theme.Material3.DayNight">
        <!-- MD3 Color Roles -->
        <item name="colorPrimary">@color/md3_primary</item>
        <item name="colorOnPrimary">@color/md3_on_primary</item>
        <item name="colorPrimaryContainer">@color/md3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md3_on_primary_container</item>
        <item name="colorSecondary">@color/md3_secondary</item>
        <item name="colorOnSecondary">@color/md3_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md3_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md3_on_secondary_container</item>
        <item name="colorTertiary">@color/md3_tertiary</item>
        <item name="colorSurface">@color/md3_surface</item>
        <item name="colorOnSurface">@color/md3_on_surface</item>
        <item name="colorSurfaceVariant">@color/md3_surface_variant</item>
        <item name="colorOutline">@color/md3_outline</item>
        <!-- MD3 Shape Attributes -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.App.LargeComponent</item>
    </style>

    <!-- Base application theme. -->
    <style name="TvTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- MD3 Color Roles -->
        <item name="colorPrimary">@color/md3_primary</item>
        <item name="colorOnPrimary">@color/md3_on_primary</item>
        <item name="colorPrimaryContainer">@color/md3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md3_on_primary_container</item>
        <item name="colorSecondary">@color/md3_secondary</item>
        <item name="colorOnSecondary">@color/md3_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md3_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md3_on_secondary_container</item>
        <item name="colorTertiary">@color/md3_tertiary</item>
        <item name="colorSurface">@color/md3_surface</item>
        <item name="colorOnSurface">@color/md3_on_surface</item>
        <item name="colorSurfaceVariant">@color/md3_surface_variant</item>
        <item name="colorOutline">@color/md3_outline</item>
        <!-- MD3 Shape Attributes -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.App.LargeComponent</item>
        <!-- TV-specific attributes -->
        <item name="android:windowBackground">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:listDivider">@drawable/divider_bg</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- MD3 Shape Appearance Styles -->
    <style name="ShapeAppearance.App.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">8dp</item>
    </style>
    <style name="ShapeAppearance.App.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.App.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="rt_title_view">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">45dip</item>
        <item name="android:background">@color/colorTitleBackground</item>
    </style>

    <style name="tv_title_name">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:layout_centerHorizontal">true</item>
        <item name="android:textColor">@color/colorWhite</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
    </style>

    <style name="tv_title_menu_left">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#6C7A80</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
    </style>

    <style name="ll_title_view1">
        <item name="android:layout_width">70dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="iv_title_menu_add">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:contentDescription">@string/title_add</item>
        <item name="android:src">@drawable/ic_add</item>
    </style>

    <!--带旋转动画的ImageView-->
    <declare-styleable name="waterRipplesView">
        <!--波的总个数-->
        <attr name="waveCount" format="integer" />
        <!--程序一开始就播放波纹涟漪动画-->
        <attr name="waveOnLoad" format="boolean" />
        <!--波的颜色-->
        <attr name="waveColor" format="color" />
    </declare-styleable>
    
    
    <style name="AppBaseTheme" parent="android:Theme.Light">
        <!--
            Theme customizations available in newer API levels can go in
            res/values-vXX/styles.xml, while customizations related to
            backward-compatibility can go here.



        -->
    </style>

    <!-- radioButton的样式抽取 -->
    <style name="radioButtonStyle">
        <item name="android:textColor">@color/rb_colors_selector</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:layout_width">0dip</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:button">@null</item>
        <item name="android:drawablePadding">5dip</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:gravity">center</item>
    </style>

</resources>
