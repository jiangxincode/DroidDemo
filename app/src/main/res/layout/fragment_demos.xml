                android:text="Vibrator Demo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSensorEntrance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="Sensor Demo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImeEntrance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text= "输入法" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSystemShare"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="系统分享功能演示" />

