<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="edu.jiangxin.droiddemo.DemosFragment">

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fadingEdge="vertical"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:scrollbarStyle="outsideInset"
            android:scrollbars="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPredictiveBack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="可预测返回" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUsageStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="Usage Stats" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="Note" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPerf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="Perf" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShowInfoEntrance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="信息展示" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVariousLayoutEntrance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="各种Layout" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDecorViewEntrance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="状态栏/标题栏设置" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVariousServiceEntrance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="各种Service" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnListViewEntrance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="各种ListView" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogEntrance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="@string/button_dialog_entrance" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRippleEntrance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="@string/button_ripple_entrance" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRoundCornerEntrance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="圆角效果" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnimationEntrance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="动画大世界" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenglEntrance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="OpenGL大世界" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBlurEntrance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="高斯模糊以及Activity生命周期展示" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnForbidScreenShotEntrance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="@string/button_forbid_screenshot_entrance" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAppListEntrance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="@string/button_app_list_entrance" />

